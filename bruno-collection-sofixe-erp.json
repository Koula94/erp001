  ],
  "environments": [
    {
      "name": "Development",
      "type": "environment",
      "data": [
        {
          "name": "base_url",
          "value": "http://127.0.0.1:8000",
          "type": "text",
          "enabled": true
        },
        {
          "name": "access_token",
          "value": "",
          "type": "text",
          "enabled": true
        },
        {
          "name": "refresh_token",
          "value": "",
          "type": "text",
          "enabled": true
        }
      ]
    }
  ]
}
