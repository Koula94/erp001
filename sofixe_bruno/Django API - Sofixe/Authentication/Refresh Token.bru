meta {
  name: Refresh Token
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/token/refresh/
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refresh": "{{refresh_token}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
      const data = res.getBody();
      if (data.access) {
          bru.setVar('auth_token', data.access);
      }
  }
}

settings {
  encodeUrl: true
}
