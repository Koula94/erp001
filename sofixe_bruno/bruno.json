{
  "info": {
    "name": "Sofixe ERP API",
    "_postman_id": "sofixe-erp-api",
    "description": "Collection complète API Sofixe ERP avec authentification JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"first_name\": \"Test\",\n  \"last_name\": \"User\",\n  \"role\": \"employee\",\n  \"phone\": \"+33123456789\",\n  \"position\": \"Développeur\",\n  \"department\": \"IT\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/auth/register/",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "auth", "register", ""]
            },
            "description": "Inscription d'un nouvel utilisateur. Rôles disponibles : admin, manager, employee, hr, stock, finance"
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    if (data.access) {",
                  "        pm.collectionVariables.set('access_token', data.access);",
                  "    }",
                  "    if (data.refresh) {",
                  "        pm.collectionVariables.set('refresh_token', data.refresh);",
                  "    }",
                  "    console.log('✅ Connexion réussie - Tokens sauvegardés');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/auth/login/",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "auth", "login", ""]
            },
            "description": "Connexion avec username et password. Retourne access_token et refresh_token."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/auth/logout/",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "auth", "logout", ""]
            },
            "description": "Déconnexion et blacklist du refresh token"
          },
          "response": []
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/auth/me/",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "auth", "me", ""]
            },
            "description": "Récupère les informations de l'utilisateur connecté"
          },
          "response": []
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"old_password\": \"ancien_motdepasse\",\n  \"new_password\": \"nouveau_motdepasse\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/auth/change-password/",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "auth", "change-password", ""]
            },
            "description": "Changer le mot de passe de l'utilisateur connecté"
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    if (data.access) {",
                  "        pm.collectionVariables.set('access_token', data.access);",
                  "        console.log('✅ Access token rafraîchi');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/token/refresh/",
              "host": ["{{base_url}}"],
              "path": ["api", "token", "refresh", ""]
            },
            "description": "Renouveler l'access token avec le refresh token"
          },
          "response": []
        },
        {
          "name": "Get Token (SimpleJWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    if (data.access) {",
                  "        pm.collectionVariables.set('access_token', data.access);",
                  "    }",
                  "    if (data.refresh) {",
                  "        pm.collectionVariables.set('refresh_token', data.refresh);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/token/",
              "host": ["{{base_url}}"],
              "path": ["api", "token", ""]
            },
            "description": "Endpoint SimpleJWT standard pour obtenir les tokens"
          },
          "response": []
        }
      ]
    },
