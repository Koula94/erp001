meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/users/auth/login/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "admin",
    "password": "123456"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
      const data = res.getBody();
      if (data.access) {
          bru.setVar('access_token', data.access);
      }
      if (data.refresh) {
          bru.setVar('refresh_token', data.refresh);
      }
      console.log('✅ Connexion réussie - Tokens sauvegardés');
  }
}

settings {
  encodeUrl: true
}

docs {
  Connexion avec username et password. Retourne access_token et refresh_token.
}
