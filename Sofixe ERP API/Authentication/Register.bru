meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/users/auth/register/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "testuser",
    "email": "test@example.com",
    "password": "password123",
    "first_name": "Test",
    "last_name": "User",
    "role": "employee",
    "phone": "+33123456789",
    "position": "Développeur",
    "department": "IT"
  }
}

settings {
  encodeUrl: true
}

docs {
  Inscription d'un nouvel utilisateur. Rôles disponibles : admin, manager, employee, hr, stock, finance
}
