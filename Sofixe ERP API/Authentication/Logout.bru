meta {
  name: Logout
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/users/auth/logout/
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:json {
  {
    "refresh_token": "{{refresh_token}}"
  }
}

settings {
  encodeUrl: true
}

docs {
  Déconnexion et blacklist du refresh token
}
