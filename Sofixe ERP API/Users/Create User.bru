meta {
  name: Create User
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/users/
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:json {
  {
    "username": "newuser",
    "email": "newuser@example.com",
    "password": "password123",
    "first_name": "John",
    "last_name": "Doe",
    "role": "employee"
  }
}

settings {
  encodeUrl: true
}
